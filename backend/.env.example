# ---------------------------------------------------------------
# SOS Patitas — variables de entorno del backend
# Copiar a .env para desarrollo local. En Railway se cargan en
# la pestaña "Variables" del servicio (nunca se sube .env al repo).
# ---------------------------------------------------------------

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos MySQL ---
# Opción A (la más simple en Railway): una sola URL.
#   En Railway: DATABASE_URL=${{MySQL.MYSQL_URL}}
# DATABASE_URL=mysql://usuario:clave@host:3306/sos_patitas
#
# Opción B: variables sueltas (Railway también las define: MYSQLHOST, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sos_patitas
# true si la base exige conexión cifrada
DB_SSL=false

# --- Seguridad ---
# Mínimo 32 caracteres, aleatorio. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# --- CORS y enlaces ---
# Dominios del frontend permitidos, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# URL pública del frontend (para el enlace compartible /c/:id).
FRONTEND_URL=http://localhost:8080
# URL pública de este backend (para armar la URL de las fotos).
PUBLIC_BASE_URL=http://localhost:3000

# --- Fotos ---
# Carpeta donde se guardan. En Railway: montar un Volume y apuntar acá (ej. /data/uploads).
UPLOADS_DIR=./uploads

# --- Privacidad ---
# true: el detalle público incluye el contacto de quien publicó (el formulario lo avisa).
# false: solo lo ve el equipo en el panel.
MOSTRAR_CONTACTO_PUBLICO=true

# --- Solo para `npm run seed:admin` ---
ADMIN_NOMBRE=Administración
ADMIN_EMAIL=admin@sospatitas.test
ADMIN_PASSWORD=cambiar-esta-clave
